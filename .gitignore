# Ignore everything by default (whitelist approach)
*

# Meta
!.gitignore
!TEST_DOCUMENTATION.md

# Main notebook
!local.ipynb

# Training outputs
!outputs/
!outputs/logs/
!outputs/logs/**
!outputs/checkpoints/
!outputs/checkpoints/**

