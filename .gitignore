# Ignore everything by default (whitelist approach)
*

# Meta
!.gitignore
!TEST_DOCUMENTATION.md
.env

# Main notebook
!local.ipynb

# Training outputs
!outputs/
!outputs/logs/
!outputs/logs/**
!outputs/checkpoints/
!outputs/checkpoints/**

# V2 notebook and related files
!local_v2.ipynb
!shared_val_manifest.json
!v3_results.json
!v3_fixed_results.json
!occlusion_test_videos.json

# V2 training run outputs
!runs/
!runs/detect/
!runs/detect/fall_detector_v2/
!runs/detect/fall_detector_v2/multiclass-4/
!runs/detect/fall_detector_v2/multiclass-4/results.csv
!runs/detect/fall_detector_v2/multiclass-4/*.png
!runs/detect/fall_detector_v2/multiclass-4/weights/
!runs/detect/fall_detector_v2/multiclass-4/weights/best.pt

# Excluded (large): outputs/tracks/, outputs/urfall_mp4/
# Excluded (large): archive/, archive_ur/, GMDCSA24-*/
# Excluded (large): Fall-Detection-1/ (downloaded Roboflow dataset)
# Excluded (sensitive): client_secret*.json
# Excluded (binary): yolov8n-pose.pt, *.zip
